generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Enable pgvector
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------
// 1. User Management & Profiles
// ---------------------------------------------------------

enum UserRole {
  STUDENT
  FACULTY
  ALUMNI
  ADMIN
}

model Profile {
  id              String   @id @default(uuid()) // Link to Supabase Auth ID
  email           String   @unique
  universityEmail String?  @unique // For verification
  username        String   @unique
  fullName        String
  avatarUrl       String?
  bio             String?
  role            UserRole @default(STUDENT)

  // Academic Info
  enrollments      CourseEnrollment[]
  mentorshipSkills MentorshipSkill[] // For matching

  // Scoping
  universityId   String?
  university     University? @relation(fields: [universityId], references: [id])
  universityName String? // Keep for display if needed, or remove. Keeping for fallback.
  department     String?
  yearOfStudy    Int?

  // Relations
  posts    Post[]
  comments Comment[]
  likes    Like[]

  // Career
  resumes Resume[]

  // Clubs & Events
  clubMemberships ClubMember[]
  eventRsvps      EventRSVP[]

  // Marketplace & Travel
  listings     MarketplaceListing[]
  rideRequests RideRequest[]
  offeredRides RideOffer[]

  // Research
  projects       ResearchProject[]
  collaborations ProjectCollaborator[]

  // Wellness
  moodLogs MoodLog[]

  // Academic AI
  academicChats AcademicAIChat[]
  flashcardSets FlashcardSet[]
  studySessions StudySession[]
  studyGroups   StudyGroupMember[]

  // Messages
  sentMessages  Message[]
  conversations ConversationParticipant[]

  // Friendships
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  // AI & Embeddings
  embedding Unsupported("vector(1536)")? // User profile embedding for matching

  bookmarks Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId])
  @@index([role])
}

// ---------------------------------------------------------
// 2. Social Feed (Campus & Universe)
// ---------------------------------------------------------

// FeedType replaced by ContentScope

enum PostType {
  TEXT
  IMAGE
  VIDEO
  LINK
}

model Post {
  id       String       @id @default(uuid())
  content  String
  mediaUrl String? // For images/videos
  type     PostType     @default(TEXT)
  scope    ContentScope @default(CAMPUS)

  authorId String
  author   Profile @relation(fields: [authorId], references: [id])

  universityId String? // If CAMPUS feed, linked to uni
  university   University? @relation(fields: [universityId], references: [id])

  category String? @default("General")

  bookmarks Bookmark[]
  likes     Like[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, universityId])
  @@index([category])
}

model Comment {
  id      String @id @default(uuid())
  content String

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   Profile @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   Profile @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Bookmark {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   Profile @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

// ---------------------------------------------------------
// NEW: University Directory & Scoping
// ---------------------------------------------------------

model University {
  id           String  @id @default(uuid())
  name         String  @unique
  abbreviation String? // e.g., "DSU", "IITB"
  location     String?
  logoUrl      String?

  // Verification Logic
  domains          String[] // e.g., ["dsu.edu.in", "student.dsu.edu"]
  studentIdPattern String? // Regex to extract ID from email user part

  // Request Tracking
  status     UniversityStatus @default(PENDING)
  website    String?
  adminName  String? // Requestor Name
  adminEmail String? // Requestor Email
  adminPhone String? // Requestor Phone

  // Relations
  students     Profile[]
  clubs        Club[]
  events       Event[]
  listings     MarketplaceListing[]
  forumThreads ForumThread[]
  courses      Course[]
  rides        RideOffer[]
  projects     ResearchProject[]
  posts        Post[]
  studyGroups  StudyGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// NEW: Study Groups & Circles
// ---------------------------------------------------------

model StudyGroup {
  id          String  @id @default(uuid())
  name        String
  description String?

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  universityId String
  university   University @relation(fields: [universityId], references: [id])

  members StudyGroupMember[]

  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyGroupMember {
  id           String     @id @default(uuid())
  studyGroupId String
  studyGroup   StudyGroup @relation(fields: [studyGroupId], references: [id])
  userId       String
  user         Profile    @relation(fields: [userId], references: [id])

  role String @default("MEMBER") // ADMIN, MEMBER

  @@unique([studyGroupId, userId])
}

enum UniversityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentScope {
  CAMPUS // Visible only to user's university
  UNIVERSE // Visible to everyone
}

// ---------------------------------------------------------
// 3. Academic & Resources
// ---------------------------------------------------------

model Course {
  id   String @id @default(uuid())
  code String // e.g., CS101
  name String

  universityId String
  university   University @relation(fields: [universityId], references: [id])

  enrollments  CourseEnrollment[]
  resources    Resource[]
  forumThreads ForumThread[]
  studyGroups  StudyGroup[]

  @@unique([universityId, code])
}

model CourseEnrollment {
  id       String  @id @default(uuid())
  userId   String
  user     Profile @relation(fields: [userId], references: [id])
  courseId String
  course   Course  @relation(fields: [courseId], references: [id])

  role String @default("STUDENT") // STUDENT, TA

  @@unique([userId, courseId])
}

enum ResourceType {
  NOTE
  PAST_PAPER
  ASSIGNMENT
  OTHER
}

model Resource {
  id          String       @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  type        ResourceType

  courseId   String
  course     Course @relation(fields: [courseId], references: [id])
  uploaderId String

  upvotes Int @default(0)

  embeddings ResourceEmbedding[]

  createdAt DateTime @default(now())
}

model ResourceEmbedding {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  content   String // The chunk of text
  embedding Unsupported("vector(1536)")

  @@index([resourceId])
}

// Mentorship Matching
model MentorshipSkill {
  id    String @id @default(uuid())
  skill String
  type  String // "OFFER" (Mentor) or "SEEK" (Mentee)

  userId String
  user   Profile @relation(fields: [userId], references: [id])

  @@index([skill])
}

// ---------------------------------------------------------
// 4. Forums (Anonymous Support)
// ---------------------------------------------------------

model ForumThread {
  id          String  @id @default(uuid())
  title       String
  content     String
  isAnonymous Boolean @default(false)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  // Scoping
  scope        ContentScope @default(CAMPUS)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id])

  // If not linked to a course, could be a general topic
  category String?

  authorId String // Even if anon, we store author for moderation (but hide in UI)

  replies ForumReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumReply {
  id          String  @id @default(uuid())
  content     String
  isAnonymous Boolean @default(false)

  threadId String
  thread   ForumThread @relation(fields: [threadId], references: [id])

  authorId String

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// 5. Career & Resume
// ---------------------------------------------------------

model Resume {
  id       String @id @default(uuid())
  fileUrl  String
  fileName String

  userId String
  user   Profile @relation(fields: [userId], references: [id])

  // AI Analysis Results
  score     Int?
  feedback  Json? // Structured feedback from AI
  satsCheck Boolean? // ATS Compatibility

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// 6. Clubs & Events
// ---------------------------------------------------------

model Club {
  id          String  @id @default(uuid())
  name        String
  description String?
  logoUrl     String?

  scope        ContentScope @default(CAMPUS)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id])

  members ClubMember[]
  events  Event[]

  createdAt DateTime @default(now())
}

model ClubMember {
  id     String  @id @default(uuid())
  clubId String
  club   Club    @relation(fields: [clubId], references: [id])
  userId String
  user   Profile @relation(fields: [userId], references: [id])
  role   String  @default("MEMBER") // ADMIN, MEMBER

  @@unique([clubId, userId])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  location    String?
  imageUrl    String?

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  scope        ContentScope @default(CAMPUS)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id])

  organizerId String // Could be a user if not a club event

  rsvps EventRSVP[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventRSVP {
  id      String  @id @default(uuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id])
  userId  String
  user    Profile @relation(fields: [userId], references: [id])
  status  String  @default("GOING") // GOING, INTERESTED, NOT_GOING

  @@unique([eventId, userId])
}

// ---------------------------------------------------------
// 7. Marketplace & Travel
// ---------------------------------------------------------

enum ListingType {
  SELL
  BUY
  LOST
  FOUND
}

model MarketplaceListing {
  id          String      @id @default(uuid())
  title       String
  description String
  price       Float?
  imageUrl    String?
  type        ListingType
  status      String      @default("ACTIVE") // ACTIVE, SOLD

  scope        ContentScope @default(CAMPUS)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id])

  sellerId String
  seller   Profile @relation(fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
}

model RideOffer {
  id    String   @id @default(uuid())
  from  String
  to    String
  date  DateTime
  seats Int
  price Float?

  scope        ContentScope @default(CAMPUS)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id])

  driverId String
  driver   Profile @relation(fields: [driverId], references: [id])

  requests RideRequest[]

  createdAt DateTime @default(now())
}

model RideRequest {
  id          String    @id @default(uuid())
  offerId     String
  offer       RideOffer @relation(fields: [offerId], references: [id])
  passengerId String
  passenger   Profile   @relation(fields: [passengerId], references: [id])
  status      String    @default("PENDING") // PENDING, ACCEPTED, REJECTED

  @@unique([offerId, passengerId])
}

// ---------------------------------------------------------
// 8. Research Hub
// ---------------------------------------------------------

model ResearchProject {
  id          String @id @default(uuid())
  title       String
  description String
  status      String @default("OPEN") // OPEN, ONGOING, COMPLETED

  scope        ContentScope @default(CAMPUS)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id])

  leadId String
  lead   Profile @relation(fields: [leadId], references: [id])

  collaborators ProjectCollaborator[]

  createdAt DateTime @default(now())
}

model ProjectCollaborator {
  id        String          @id @default(uuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id])
  userId    String
  user      Profile         @relation(fields: [userId], references: [id])
  role      String // RESEARCHER, ADVISOR

  @@unique([projectId, userId])
}

// ---------------------------------------------------------
// 9. Wellness (Mood Logger)
// ---------------------------------------------------------

model MoodLog {
  id     String  @id @default(uuid())
  userId String
  user   Profile @relation(fields: [userId], references: [id])

  moodScore  Int // 1-10 or 1-5
  notes      String?
  activities String[] // e.g., ["Exercise", "Meditation"]

  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// ---------------------------------------------------------
// 10. Messaging (Realtime)
// ---------------------------------------------------------

model Conversation {
  id      String  @id @default(uuid())
  isGroup Boolean @default(false)
  name    String? // For group chats

  participants ConversationParticipant[]
  messages     Message[]

  updatedAt DateTime @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           Profile      @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id      String @id @default(uuid())
  content String

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         Profile      @relation(fields: [senderId], references: [id])

  readBy String[] // Array of user IDs who read it

  createdAt DateTime @default(now())
}

model Friendship {
  id        String   @id @default(uuid())
  requesterId String
  requester   Profile @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   Profile @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// ---------------------------------------------------------
// 11. Academic AI Specific Models
// ---------------------------------------------------------

model AcademicAIChat {
  id     String  @id @default(uuid())
  userId String
  user   Profile @relation(fields: [userId], references: [id])

  title    String? // Auto-generated title for the chat
  messages AcademicAIChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicAIChatMessage {
  id     String         @id @default(uuid())
  chatId String
  chat   AcademicAIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role    String // "user" or "assistant"
  content String

  createdAt DateTime @default(now())
}

model FlashcardSet {
  id          String  @id @default(uuid())
  title       String
  description String?

  userId String
  user   Profile @relation(fields: [userId], references: [id])

  courseId   String?
  flashcards Flashcard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flashcard {
  id    String       @id @default(uuid())
  setId String
  set   FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  front String
  back  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudySession {
  id     String  @id @default(uuid())
  userId String
  user   Profile @relation(fields: [userId], references: [id])

  duration Int // Seconds
  mode     String // "focus" or "break"

  courseId String?

  createdAt DateTime @default(now())
}
